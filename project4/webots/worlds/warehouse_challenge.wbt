DEF PING_RING Transform {
  translation 24 9.5 -2
  scale 0.5 0.5 0.5
  children [
    Shape {
      castShadows FALSE
      isPickable FALSE
      appearance DEF PING_RING_MATERIAL PBRAppearance {
        baseColor 0 0 0
        baseColorMap DEF PING_RING_TEXTURE ImageTexture {
          url [
            "../textures/ping_ring.png"
          ]
        }
        transparency 0.99
        roughness 1
        metalness 0
        emissiveColorMap USE PING_RING_TEXTURE
        emissiveColor 0 0.85 1
        emissiveIntensity 3
      }
      geometry Plane {
        size 2 2
      }
    }
  ]
}
