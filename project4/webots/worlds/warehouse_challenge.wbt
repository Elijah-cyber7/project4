WorldInfo {
  info [
    "CS 3630 Project 4: Autonomous Warehouse Challenge."
    "The warehouse of Chapter 4 of Dellaert & Hutchinson, Introduction to Robotics and Perception."
    "World frame = book frame: x east, y north (meters), origin at the center of grid cell (0, 0)."
  ]
  title "CS 3630 Warehouse Challenge"
  basicTimeStep 32
  FPS 30
}
